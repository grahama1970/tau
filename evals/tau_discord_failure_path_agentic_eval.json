          {"path": "../local/agentic-evals/tau-discord-failure-path-proof.json", "json_pointer": "/ok", "equals": true},
          {"path": "../local/agentic-evals/tau-discord-failure-path-proof.json", "json_pointer": "/notification_status", "equals": "CHANNEL_NOT_FOUND"},
          {"path": "../local/agentic-evals/tau-discord-failure-path-proof.json", "json_pointer": "/discord_question_state/state", "equals": "OPS_DISCORD_NOTIFICATION_FAILED"},
          {"path": "../local/agentic-evals/tau-discord-failure-path-proof.json", "json_pointer": "/discord_question_state/ops_discord_notification_ok", "equals": false}
        ]
