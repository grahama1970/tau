    }
  ],
  "cases": [
    {
      "name": "missing-discord-channel-is-visible-failure",
      "type": "adversarial",
      "real_world": true,
      "evidence_class": "live_e2e",
      "supports_claims": ["tau.discord.failure_path_visible"],
      "timeout_seconds": 180,
      "command": ["bash", "-lc", "cd .. && uv run python scripts/agentic-eval-tau-discord-failure-path.py --out local/agentic-evals/tau-discord-failure-path-proof.json"],
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["\"status\": \"PASS\"", "CHANNEL_NOT_FOUND", "OPS_DISCORD_NOTIFICATION_FAILED"],
