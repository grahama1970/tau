{
  "version": 2,
  "skill": "tau-agentic-eval-evidence-index",
  "trials": 2,
  "proof_scope": "Tau retained agentic-eval evidence index build and fail-closed verification",
  "claims": {
    "proves": "Tau builds a verifier-owned evidence index over retained agentic-eval reports and referenced artifacts, re-reads that index without regenerating reports, and fails closed on mutation, substitution, deletion, and dirty-tree controls.",
    "does_not_prove": "Provider semantic quality, human acceptance of the full five-DAG product outcome, or that the verifier's self-referential agentic-evals report is itself a milestone input."
  },
  "capability_claims": [
    {
      "id": "tau.agentic_eval_evidence_index.revision_bound_retained_reports",
      "description": "Tau content-addresses retained agentic-eval reports and report-referenced artifacts, records report commands and runner schema version, binds report source SHA/ref and checkout dirty-tree declarations, and verifies the retained evidence fail-closed.",
      "criticality": "critical",
      "evidence_required": {
        "live_e2e": true,
        "fault_injected_deterministic": true
      }
    }
  ],
  "cases": [
