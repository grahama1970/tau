      "timeout_seconds": 180,
      "command": [
        "bash",
        "-lc",
        "cd .. && uv run python scripts/agentic-eval-tau-agentic-eval-evidence-index.py --mode positive --repo . --out local/agentic-evals/tau-agentic-eval-evidence-index-positive-proof.json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["\"status\": \"PASS\""],
        "artifacts": [
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-positive-proof.json", "json_pointer": "/ok", "equals": true},
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-positive-proof.json", "json_pointer": "/retained_reports_live_readback/live", "equals": true},
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-positive-proof.json", "json_pointer": "/retained_reports_live_readback/mocked", "equals": false},
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-positive-proof.json", "json_pointer": "/retained_reports_live_readback/all_unmocked", "equals": true},
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index.json", "json_pointer": "/schema", "equals": "tau.agentic_eval_evidence_index.v1"},
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-pass-receipt.json", "json_pointer": "/schema", "equals": "tau.agentic_eval_evidence_verification.v1"},
