          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-pass-receipt.json", "json_pointer": "/retained_reports_live_readback/live", "equals": true},
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-pass-receipt.json", "json_pointer": "/retained_reports_live_readback/mocked", "equals": false},
          {"path": "../local/agentic-evals/tau-agentic-eval-evidence-index-pass-receipt.json", "json_pointer": "/retained_reports_live_readback/all_unmocked", "equals": true}
