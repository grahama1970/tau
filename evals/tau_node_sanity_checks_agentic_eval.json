    {
      "id": "tau.node_sanity_checks",
      "description": "Tau project DAGs enforce typed node sanity checks and fail closed on prose-only, missing, wrong-type, null/empty/Unicode, malformed, contradictory, stale, unbound, mocked, visual-receipt, parity, and topology-bypass evidence.",
      "criticality": "critical",
      "claim_semantics": "protocol",
      "evidence_required": {
        "fault_injected_deterministic": 1,
        "live_e2e": 1
      }
    }
  ],
  "seams": [
    {
      "seam_id": "project_dag.node_sanity_checks",
      "seam_type": "runtime_contract",
      "criticality": "critical",
      "required_evidence": [
        "fault_injected_deterministic",
        "live_e2e"
      ]
    }
  ],
  "claims": {
    "proves": "The retained matrix runs 30 Tau project-DAG cases through run_project_dag_contract and checks that typed failure codes, artifact hashes, attempt ids, null/empty/Unicode values, malformed JSON, precedence, handoff-loop parity, visual receipts, and reviewer/topology rules are enforced by machine-readable receipts.",
    "does_not_prove": "Provider semantic quality, human aesthetic acceptance, deployment, or GOAL.md completion."
  },
