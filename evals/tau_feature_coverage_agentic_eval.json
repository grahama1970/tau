      "criticality": "critical",
      "evidence_required": {"live_e2e": true, "fault_injected_deterministic": true}
    }
  ],
  "cases": [
    {
      "name": "all-feature-eval-manifests-have-ready-claim-coverage",
      "type": "positive",
      "real_world": true,
      "evidence_class": "live_e2e",
      "supports_claims": ["tau.feature_agentic_eval_coverage"],
      "timeout_seconds": 60,
      "command": [
        "bash",
        "-lc",
        "cd .. && uv run python scripts/agentic-eval-tau-feature-coverage.py --mode positive --out local/agentic-evals/tau-feature-coverage-proof.json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["\"status\": \"PASS\""],
        "artifacts": [
          {"path": "../local/agentic-evals/tau-feature-coverage-proof.json", "json_pointer": "/ok", "equals": true},
          {"path": "../local/agentic-evals/tau-feature-coverage-proof.json", "json_pointer": "/mocked", "equals": false},
          {"path": "../local/agentic-evals/tau-feature-coverage-proof.json", "json_pointer": "/live", "equals": true},
          {"path": "../local/agentic-evals/tau-feature-coverage-proof.json", "json_pointer": "/manifest_count", "equals": 14},
          {"path": "../local/agentic-evals/tau-feature-coverage-proof.json", "json_pointer": "/claim_count", "equals": 14}
        ]
      }
    },
    {
      "name": "missing-capability-claim-is-rejected",
      "type": "adversarial",
      "real_world": true,
      "evidence_class": "fault_injected_deterministic",
      "supports_claims": ["tau.feature_agentic_eval_coverage"],
      "timeout_seconds": 60,
      "command": [
        "bash",
        "-lc",
        "cd .. && uv run python scripts/agentic-eval-tau-feature-coverage.py --mode adversarial --out local/agentic-evals/tau-feature-coverage-adversarial-proof.json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["\"status\": \"PASS\"", "\"detected\": true"],
        "artifacts": [
          {"path": "../local/agentic-evals/tau-feature-coverage-adversarial-proof.json", "json_pointer": "/ok", "equals": true},
          {"path": "../local/agentic-evals/tau-feature-coverage-adversarial-proof.json", "json_pointer": "/mocked", "equals": false},
          {"path": "../local/agentic-evals/tau-feature-coverage-adversarial-proof.json", "json_pointer": "/live", "equals": true},
          {"path": "../local/agentic-evals/tau-feature-coverage-adversarial-proof.json", "json_pointer": "/adversarial_detection", "equals": true}
        ]
      }
