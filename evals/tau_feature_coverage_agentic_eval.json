{
  "version": 2,
  "skill": "tau-feature-agentic-eval-coverage",
  "trials": 2,
  "proof_scope": "Tau feature-to-agentic-eval coverage posture across committed Tau eval manifests and retained reports",
  "claims": {
    "proves": "Every committed Tau feature eval manifest declares capability_claims, each critical claim has supporting evidence-class cases, retained reports are READY/live/non-mocked, and deleting a capability claim is caught by the coverage guard.",
