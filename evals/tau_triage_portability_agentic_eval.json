{
  "version": 2,
  "skill": "tau-triage-portability",
  "trials": 2,
  "proof_scope": "Tau DAG triage classification portability from installed wheel",
  "claims": {
    "proves": "A clean installed Tau wheel no longer executes an old home-relative agent-skills triage-error runner, classifies a known internal DAG evidence failure through native fallback, uses an explicitly configured triage-error skill root when present, and reports unavailable classifier state truthfully.",
    "does_not_prove": "Full triage-error catalog parity, provider/model quality, all security findings, GOAL.md completion, or human acceptance."
  },
  "capability_claims": [
    {
      "id": "tau.triage.portable_classifier_resolution",
