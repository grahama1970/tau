      "supports_claims": ["tau.triage.portable_classifier_resolution"],
      "timeout_seconds": 240,
      "command": [
        "bash",
        "-lc",
        "cd .. && rm -rf local/agentic-evals/tau-triage-portability && uv run python scripts/agentic-eval-tau-triage-portability.py --work local/agentic-evals/tau-triage-portability/work --out local/agentic-evals/tau-triage-portability/proof.json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["\"status\": \"PASS\"", "\"classifier_kind\": \"NATIVE_FALLBACK\"", "\"classifier_kind\": \"EXTERNAL_CLASSIFIER\""],
        "artifacts": [
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/ok", "equals": true},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/mocked", "equals": false},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/live", "equals": true},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/old_home_relative_runner_executed", "equals": false},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/native_fallback/code", "equals": "tau_project_dag_missing_required_evidence"},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/native_fallback/classifier_kind", "equals": "NATIVE_FALLBACK"},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/external_classifier/classifier_kind", "equals": "EXTERNAL_CLASSIFIER"},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/unavailable_classifier/classifier_kind", "equals": "UNAVAILABLE"},
          {"path": "../local/agentic-evals/tau-triage-portability/proof.json", "json_pointer": "/source_scan_exit_code", "equals": 0}
        ]
      }
    }
  ]
