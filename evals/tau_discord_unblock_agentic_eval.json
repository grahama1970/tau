{
  "version": 2,
  "skill": "tau-discord-unblock",
  "trials": 2,
  "proof_scope": "Tau Discord human-decision receipts for repair overlays",
  "claims": {
    "proves": "Tau can attach Discord human-question state to a repair overlay, keep read-only status receipts from unblocking decisions, and validate a typed answer receipt against question_id, run_id, node_id, goal_hash, and allowed answers.",
    "does_not_prove": "Discord network delivery, repair completion, provider semantic quality, or human acceptance of the repaired output."
  },
  "capability_claims": [
    {
      "id": "tau.discord.typed_human_unblock_receipts",
      "description": "Discord collaboration state is typed and can unblock only through a matching answer receipt, not through status text.",
      "criticality": "critical",
      "evidence_required": {"live_e2e": true}
    }
  ],
  "cases": [
    {
      "name": "live-discord-question-status-answer-validation",
      "type": "adversarial",
      "real_world": true,
      "evidence_class": "live_e2e",
      "supports_claims": ["tau.discord.typed_human_unblock_receipts"],
      "timeout_seconds": 180,
      "command": [
        "bash",
        "-lc",
        "cd .. && uv run python scripts/agentic-eval-tau-discord-unblock.py --out local/agentic-evals/tau-discord-unblock-proof.json --discord-bot --channel-name horus"
      ],
      "expected": {
        "exit_code": 0,
        "stdout_contains": ["\"status\": \"PASS\"", "\"answer_unblocks_decision\": true", "\"status_unblocks_decision\": false"],
        "artifacts": [
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/ok", "equals": true},
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/mocked", "equals": false},
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/live", "equals": true},
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/status_unblocks_decision", "equals": false},
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/answer_unblocks_decision", "equals": true},
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/discord_question_state/state", "equals": "QUESTION_SENT"},
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/ops_discord_notification_receipt/schema", "equals": "ops_discord.notification_receipt.v1"},
          {"path": "../local/agentic-evals/tau-discord-unblock-proof.json", "json_pointer": "/ops_discord_notification_receipt/status", "equals": "DRY_RUN"}
        ]
      }
    }
  ]
}
