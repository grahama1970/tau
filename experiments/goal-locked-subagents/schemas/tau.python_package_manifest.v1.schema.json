{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tau.python_package_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "python_executable", "python_version", "platform", "packages", "security_profile", "available", "errors", "sha256"],
  "properties": {
    "schema": {"const": "tau.python_package_manifest.v1"},
    "python_executable": {"type": "string", "minLength": 1},
    "python_version": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "packages": {"type": "object"},
    "security_profile": {"type": "object"},
    "available": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
