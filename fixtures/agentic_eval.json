{
  "version": 2,
  "skill": "tau",
  "trials": 2,
  "proof_scope": "non-mocked local subprocess execution, live streaming observation through the real LocalRuntimeBackend, receipt-completeness invariants, and live DAG viewer transition-to-ledger correlation",
  "claims": {
    "proves": "Tau observes node output while a command is still running, exposes it through the backend capture contract, never marks a partial capture complete, still assembles an intact final receipt, and binds live DAG viewer transitions to authoritative run, event, and ledger IDs",
    "does_not_prove": "provider or model semantic quality, GitHub mutation, Herdr pane behavior, production deployment, or that any specific downstream worker streams its own output"
  },
  "cases": [
    {
      "name": "node-output-streams-before-process-exit",
      "type": "positive",
      "real_world": true,
      "command": ["uv", "run", "--project", "..", "python", "../scripts/eval_streaming.py"],
      "timeout_seconds": 180,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "streaming observable before exit: PASS",
          "chunks arrive progressively: PASS",
          "capture answers mid run: PASS",
          "capture grows while running: PASS",
          "tau streaming eval: PASS"
        ]
      }
    },
    {
      "name": "partial-capture-never-reads-as-complete-receipt",
      "type": "adversarial",
      "real_world": true,
      "command": ["uv", "run", "--project", "..", "python", "../scripts/eval_streaming.py"],
      "timeout_seconds": 180,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "partial never marked complete: PASS",
          "final capture marked complete and intact: PASS"
        ]
      }
    },
    {
      "name": "streaming-assertion-rejects-non-streaming-baseline",
      "type": "adversarial",
      "real_world": true,
      "command": ["uv", "run", "--project", "..", "python", "../scripts/eval_streaming.py"],
      "timeout_seconds": 180,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "negative control rejects non-streaming baseline: PASS"
        ]
      }
    },
    {
      "name": "local-runtime-cancellation-and-timeout-terminate",
      "type": "positive",
      "real_world": true,
      "command": ["uv", "run", "--project", "..", "python", "../scripts/eval_local_runtime_contract.py"],
      "timeout_seconds": 240,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "cancellation returns 130 and stops early: PASS",
          "cancellation records reason in stderr: PASS",
          "timeout returns 124 and stops early: PASS",
          "timeout records reason in stderr: PASS",
          "tau local runtime contract: PASS"
        ]
      }
    },
    {
      "name": "local-runtime-kills-orphaned-grandchildren",
      "type": "adversarial",
      "real_world": true,
      "command": ["uv", "run", "--project", "..", "python", "../scripts/eval_local_runtime_contract.py"],
      "timeout_seconds": 240,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "process group cleanup kills grandchildren: PASS",
          "large output does not deadlock: PASS"
        ]
      }
    },
    {
      "name": "local-runtime-capture-fails-closed-on-bad-input",
      "type": "adversarial",
      "real_world": true,
      "command": ["uv", "run", "--project", "..", "python", "../scripts/eval_local_runtime_contract.py"],
      "timeout_seconds": 240,
      "expected": {
        "exit_code": 0,
        "stdout_contains": [
          "capture on unstarted endpoint fails closed: PASS",
          "capture rejects negative line bound: PASS",
          "capture honours zero line bound: PASS",
          "stdin delivered and confirmed: PASS"
        ]
      }
    },
    {
      "name": "live-dag-viewer-transitions-correlate-to-ledger",
      "type": "positive",
